    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiniChess.Core\MiniChess.Core.csproj" />
    <!-- JSON 형식(ProtocolJson). Unity 의 com.unity.nuget.newtonsoft-json 3.2.1 과 같은 버전 -->
